# POSTGRES
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex_password
POSTGRES_DB=apex_flow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# EXCHANGE SETTINGS
# Symbols to track (comma-separated)
TRACKED_SYMBOLS=BTCUSDT,ETHUSDT
# Active exchanges (comma-separated)
ACTIVE_EXCHANGES=binance,bybit

# LOGGING
LOG_LEVEL=INFO
